#usda 1.0
(
    defaultPrim = "Gripper"
    doc = "A gripper for the USD Viewer sample robot. sample-robot.usda references it."
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "Gripper" (
    kind = "component"
    prepend apiSchemas = ["MaterialBindingAPI"]
)
{
    rel material:binding = </Gripper/Looks/Chrome>

    def Mesh "Palm"
    {
        float3[] extent = [(-5, 0, -3), (5, 4, 3)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 3, 2, 4, 6, 7, 5, 0, 4, 5, 1, 2, 3, 7, 6, 0, 2, 6, 4, 1, 5, 7, 3]
        point3f[] points = [(-5, 0, -3), (5, 0, -3), (-5, 4, -3), (5, 4, -3), (-5, 0, 3), (5, 0, 3), (-5, 4, 3), (5, 4, 3)]
    }

    def Cone "FingerL"
    {
        uniform token axis = "Y"
        double height = 9
        double radius = 1.5
        double3 xformOp:translate = (-3.5, 8.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cone "FingerR"
    {
        uniform token axis = "Y"
        double height = 9
        double radius = 1.5
        double3 xformOp:translate = (3.5, 8.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Scope "Looks"
    {
        def Material "Chrome"
        {
            token outputs:surface.connect = </Gripper/Looks/Chrome/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.85, 0.86, 0.88)
                float inputs:metallic = 1
                float inputs:roughness = 0.15
                token outputs:surface
            }
        }
    }
}

