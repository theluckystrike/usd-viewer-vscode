#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
)

def Xform "World"
{
    def PointInstancer "Crates"
    {
        point3f[] positions = [(0, 0, 0), (3, 0, 0), (6, 0, 0)]
        int[] protoIndices = [0, 0, 1]
        rel prototypes = [
            </World/Crates/Protos/Box>,
            </World/Crates/Protos/Ball>,
        ]

        def Scope "Protos"
        {
            def Cube "Box"
            {
                double size = 1
            }

            def Sphere "Ball"
            {
                double radius = 0.5
            }
        }
    }

    def Mesh "Broken"
    {
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 0, 2, 9]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    }

    def Xform "Lamp" (
        prepend references = @./missing-lamp.usda@
    )
    {
    }

    def Shader "Tex"
    {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @./textures/missing.png@
    }
}
