#usda 1.0
(
    defaultPrim = "Root"
    subLayers = [@./a.usda@ (offset = 2)]
)
def Xform "Root" (
    prepend references = @./x.usda@</X>
    variants = {
 string look = "red"
 }
    prepend variantSets = "look"
    prepend apiSchemas = ["MaterialBindingAPI"]
    kind = "component"
)
{
    rel material:binding = </Root/Mat>
    float3 inputs:c.connect = </Root/Mat.outputs:surface>
    float3[] extent = [(0,0,0),(1,1,1)]
    double3 xformOp:translate.timeSamples = { 1: (0,0,0), 2: (1,1,1) }
    uniform token[] xformOpOrder = ["xformOp:translate"]
    def Material "Mat" {
 token outputs:surface
 }
    variantSet "look" = {
        "red" (
 kind = "subcomponent"
 ) {
 def Sphere "S" {
 double radius = 2
 }
 }
        "blue" { }
    }
}
