#usda 1.0
(
    defaultPrim = "Root"
    subLayers = [
        @./a.usda@ (offset = 2)
    ]
)

def Xform "Root" (
    prepend apiSchemas = ["MaterialBindingAPI"]
    kind = "component"
    prepend references = @./x.usda@</X>
    variants = {
        string look = "red"
    }
    prepend variantSets = "look"
)
{
    float3[] extent = [(0, 0, 0), (1, 1, 1)]
    float3 inputs:c.connect = </Root/Mat.outputs:surface>
    rel material:binding = </Root/Mat>
    double3 xformOp:translate.timeSamples = {
        1: (0, 0, 0),
        2: (1, 1, 1),
    }
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Material "Mat"
    {
        token outputs:surface
    }
    variantSet "look" = {
        "blue" {

        }
        "red" (
            kind = "subcomponent"
        ) {
            def Sphere "S"
            {
                double radius = 2
            }

        }
    }
}

